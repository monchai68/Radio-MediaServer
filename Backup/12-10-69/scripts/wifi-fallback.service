[Unit]
Description=Start Wi-Fi setup hotspot if no network connects on boot
After=NetworkManager.service network-online.target
Wants=NetworkManager.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/wifi-fallback.sh
# The script may wait up to WAIT_SECONDS (90) + saved-profile retries (~40s)
TimeoutStartSec=180
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target
